---
import LanguageAndThemeSelector from '@/components/LanguageAndThemeSelector.astro'
import ProjectsLayout from '@/layouts/ProjectsLayout.astro'
import { getCollection } from 'astro:content'
import ProjectsAside from '@/components/ProjectsAside.astro'
import GitHub from '@/assets/icons/GitHub.astro'
import { prepareCorrectSingleRoutePath } from '@/data/prepareCorrectRoutePaths'
import { projectsTechs } from '@/data/projectTechs'
import { type Techs } from '@/types/project.d'
import Tooltip from '@/components/Tooltip.astro'
import { projectsPageTranslations } from '@/i18n/translations'

export function getStaticPaths() {
  return [
    { params: { pageLang: 'en' } },
    { params: { pageLang: 'es' } },
    { params: { pageLang: 'ca' } },
  ]
}

const { deploy_tooltip, info_readme, techs_title } = projectsPageTranslations(
  Astro.url
)

const { pageLang } = Astro.params
const allProjects = await getCollection('projects')
const filteredProjects = allProjects.filter(
  (project) => project.data.language === pageLang
)
---

<ProjectsLayout>
  <section
    id='header'
    class={`
      bg-blue-100/40 hover:bg-blue-200/40 dark:bg-black/80 dark:hover:bg-black/50
      border-2 border-blue-800/10 dark:border-section-primary-border-dark
      flex flex-col
      md:grid md:grid-cols-[0.2fr_0.6fr_0.2fr] md:gap-x-2 md:p-0
    `}
    transition:name='header'
  >
    <a
      class={`
      text-heading-light dark:text-heading-dark
      hover:bg-black/5 dark:hover:bg-black/30 hover:underline
      flex items-center justify-center rounded-l-[8px] text-lg transition-colors duration-500
    `}
      href={`/${pageLang}`}
    >
      Back
    </a>
    <h1
      class='font-semibold text-2xl text-center py-[1rem] md:py-[2rem] text-heading-light dark:text-heading-dark'
    >
      AlbertLnz's Projects
    </h1>
    <LanguageAndThemeSelector path='/projects' />
  </section>

  <section
    id='aside'
    class={`
      bg-blue-100/40 hover:bg-blue-200/40 dark:bg-black/80 dark:hover:bg-black/50
      border-2 border-blue-800/10 dark:border-section-primary-border-dark
      flex flex-col
    `}
    transition:name='aside'
  >
    <ProjectsAside projects={filteredProjects} />
  </section>

  <section
    id='content'
    class={`
      bg-blue-100/40 hover:bg-blue-200/40 dark:bg-black/80 dark:hover:bg-black/50
      border-2 border-blue-800/10 dark:border-section-primary-border-dark
      p-0 h-full max-h-full overflow-hidden
    `}
    transition:name='content'
  >
    {
      filteredProjects.map((project) => (
        <article
          id={`project-${project.data.id}`}
          class='hidden relative p-6 overflow-hidden flex-col items-center justify-around text-secondary-light dark:text-secondary-dark'
          data-project
        >
          <div class='mb-6 flex items-center justify-between w-full'>
            <h2 class='text-center text-4xl font-bold text-heading-light dark:text-heading-dark mx-auto'>
              <Tooltip tooltipTxt={project.data.links.deploy || deploy_tooltip}>
                <a
                  href={project.data.links.deploy}
                  target='_blank'
                  class='hover:cursor-pointer hover:underline'
                >
                  {project.data.title}
                </a>
              </Tooltip>
            </h2>
            <a href={project.data.links.github} target='_blank' class='mr-6'>
              <GitHub class='size-8 fill-black/90 hover:fill-black dark:fill-white/90 dark:hover:fill-white' />
            </a>
          </div>
          <div class='flex w-full'>
            <img
              src={project.data.img}
              alt={project.data.title}
              class='size-52 rounded-lg'
            />
            <div class='flex flex-col flex-1 justify-between px-4 py-2 leading-relaxed tracking-wide'>
              <p>{project.data.longDescription}</p>
              <p class='text-base'>
                {info_readme}{' '}
                <span class='hover:underline hover:text-black/90 dark:hover:text-white/90'>
                  <a
                    href={`projects/${prepareCorrectSingleRoutePath(project)}`}
                  >
                    Readme
                  </a>
                </span>
              </p>
            </div>
          </div>
          <div class='flex flex-col w-full mt-4 p-2'>
            <h4 class='text-2xl font-semibold mb-2'>{techs_title}</h4>
            <ul class='flex ml-2 gap-x-6 text-base font-light'>
              {project.data.techs.map((tech: string) => {
                const techObj = projectsTechs[tech as Techs]
                return (
                  <li class='flex items-center justify-center gap-x-1'>
                    {<techObj.icon class='size-6' />}
                    {tech}
                  </li>
                )
              })}
            </ul>
          </div>
        </article>
      ))
    }
  </section>
</ProjectsLayout>

<script>
  document.addEventListener('astro:page-load', function () {
    const $$ = (els: string): NodeListOf<HTMLElement> =>
      document.querySelectorAll<HTMLElement>(els)

    const articles = $$('article[data-project]')
    const buttons = $$('button[id^="project-"]')

    if (articles.length > 0) {
      const lastProject = articles[articles.length - 1]
      lastProject.style.display = 'flex'
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const projectId = button.id.replace('project-', '')

        articles.forEach((article) => {
          article.style.display =
            article.id === `project-${projectId}` ? 'flex' : 'none'
        })

        buttons.forEach((btn) => btn.classList.remove('active'))
        button.classList.add('active')
      })
    })
  })
</script>
