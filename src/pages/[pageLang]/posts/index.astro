---
import { getCollection } from 'astro:content'
import BlogLayout from '@/layouts/BlogLayout.astro'
import BlogCard from '@/components/BlogCard.astro'
import BlogAside from '@/components/BlogAside.astro'
import LanguageAndThemeSelector from '@/components/LanguageAndThemeSelector.astro'
import { pagesHeaderTranslations } from '@/i18n/translations'

export function getStaticPaths() {
  return [
    { params: { pageLang: 'en' } },
    { params: { pageLang: 'es' } },
    { params: { pageLang: 'ca' } },
  ]
}
const { pageLang } = Astro.params

const allPosts = await getCollection('posts')
const posts = allPosts.filter((project) => project.data.language === pageLang)
const { back } = pagesHeaderTranslations(Astro.url)
---

<BlogLayout title='Blog' description='SEO description for blog section'>
  <section
    id='header'
    class={`
      bg-blue-100/40 hover:bg-blue-200/40 dark:bg-black/80 dark:hover:bg-black/50
      border-2 border-blue-800/10 dark:border-section-primary-border-dark
      flex flex-col
      md:grid md:grid-cols-[0.2fr_0.6fr_0.2fr] md:gap-x-2 md:p-0
    `}
    transition:name='header'
  >
    <a
      class={`
      text-heading-light dark:text-heading-dark
      hover:bg-black/5 dark:hover:bg-black/30 hover:underline
      flex items-center justify-center rounded-[8px] md:rounded-l-[8px] md:rounded-r-none text-lg transition-colors duration-500`}
      href={`/${pageLang}`}
    >
      {back}
    </a>
    <h1
      class='font-semibold text-2xl text-center py-[1rem] md:py-[2rem] text-heading-light dark:text-heading-dark'
    >
      AlbertLnz's Blog
    </h1>
    <LanguageAndThemeSelector path='/posts' />
  </section>

  <section
    id='aside'
    class={`
      bg-blue-100/40 hover:bg-blue-200/40 dark:bg-black/80 dark:hover:bg-black/50
      border-2 border-blue-800/10 dark:border-section-primary-border-dark
      h-fit
    `}
    transition:name='aside'
  >
    <BlogAside posts={posts} />
  </section>

  <section
    id='content'
    class={`
      bg-blue-100/40 hover:bg-blue-200/40 dark:bg-black/80 dark:hover:bg-black/50
      border-2 border-blue-800/10 dark:border-section-primary-border-dark
      grid grid-cols-1 xl:grid-cols-2 grid-flow-row place-items-start gap-6 overflow-x-hidden h-fit
    `}
    transition:name='content'
  >
    {
      posts.map((project) => (
        <BlogCard
          id={project.data.id}
          title={project.data.title}
          date={project.data.date}
          tag={project.data.tag}
          author={project.data.author}
        />
      ))
    }
  </section>
</BlogLayout>
