---
import Layout from '@/layouts/Layout.astro'
import Header from '@/sections/Header.astro'
import Works from '@/sections/Works.astro'
import Stack from '@/sections/Stack.astro'
import Footer from '@/sections/Footer.astro'
import AboutMe from '@/components/AboutMe.astro'
import TitleSection from '@/components/TitleSection.astro'
---

<Layout>
  <Header />
  <AboutMe />

  <TitleSection
    title='Works.'
    subtitle='You can download my CV right here.'
    icon='works'
  />
  <Works />

  <TitleSection
    title='Projects.'
    subtitle='My personal projects.'
    icon='projects'
  />

  <TitleSection
    title='Stack.'
    subtitle='The tech stack I use daily.'
    icon='stack'
  />
  <Stack />

  <Footer />
</Layout>
