---
import Layout from '@/layouts/Layout.astro'
import Header from '@/sections/Header.astro'
import Works from '@/sections/Works.astro'
import Projects from '@/sections/Projects.astro'
import Stack from '@/sections/Stack.astro'
import Footer from '@/sections/Footer.astro'
import AboutMe from '@/components/AboutMe.astro'
import TitleSection from '@/components/TitleSection.astro'
import GitHubHero from '@/sections/GitHubHero.astro'
---

<Layout>
  <Header />
  <AboutMe />
  <GitHubHero />

  <TitleSection
    id='works'
    title='Works.'
    subtitle='Curious about my background? Download my CV here:'
    icon='works'
  />
  <Works />

  <TitleSection
    id='projects'
    title='Projects.'
    subtitle="Some of the ideas I've turned into code."
    icon='projects'
  />
  <Projects />

  <TitleSection
    id='stack'
    title='Stack.'
    subtitle='Tools and technologies I rely on daily.'
    icon='stack'
  />
  <Stack />

  <Footer />
</Layout>
