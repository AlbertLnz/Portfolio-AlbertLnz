---
import '@/styles/global.css'
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <title>Albert Lanza portfolio</title>

    <!-- Preload de las fuentes para que no se vea el cambio de fuente al cargar la pagina -->
    <link
      rel='preload'
      href='/fonts/Geist-VariableFont_wght.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-300-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-400-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-500-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-600-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-700-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />

    <meta property='og:url' content='https://www.albertlnz.dev' />
    <meta property='og:type' content='website' />
    <meta property='og:title' content='Portfolio Web de Albert Lanza' />
    <meta
      property='og:description'
      content='Portfolio Web de Albert Lanza - Desarrollador Fullstack'
    />
    <meta
      property='og:image'
      content='https://www.albertlnz.dev/AlbertLanza_portfolio.webp'
    />
    <meta property='og:locale' content='es_ES' />
    <meta
      property='og:site_name'
      content='Explora el portfolio de Albert Lanza: proyectos, experiencia y habilidades como desarrollador fullstack.'
    />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:creator' content='@LnzAlbert' />
    <meta name='twitter:title' content='Portfolio Web de Albert Lanza' />
    <meta
      name='twitter:description'
      content='Descubre el portfolio web de Albert Lanza, especializado en desarrollo fullstack moderno.'
    />
  </head>
  <body
    class='bg-primary-bckg text-primary-text dark:bg-primary-bckg-dark dark:text-primary-text-dark'
  >
    <div
      class='absolute top-0 -z-50 size-full
      bg-primary-bckg bg-[radial-gradient(ellipse_75%_75%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]
      dark:bg-primary-bckg-dark dark:bg-[radial-gradient(ellipse_75%_75%_at_50%_-20%,rgba(120,119,198,0.3),rgba(0,0,0,0))]'
    >
    </div>
    <main class='max-w-3xl min-h-screen mx-auto px-8'>
      <slot />
    </main>
  </body>
</html>

<script>
  if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
    document.body.classList.add('dark')
  }
</script>
