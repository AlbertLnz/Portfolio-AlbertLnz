---
import '@/styles/global.css'
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <title>Albert Lanza portfolio</title>

    <!-- Preload de las fuentes para que no se vea el cambio de fuente al cargar la pagina -->
    <link
      rel='preload'
      href='/fonts/Geist-VariableFont_wght.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-300-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-400-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-500-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-600-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='/fonts/hind-madurai-latin-700-normal.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />

    <meta property='og:url' content='https://www.albertlnz.dev' />
    <meta property='og:type' content='website' />
    <meta property='og:title' content='Portfolio Web de Albert Lanza' />
    <meta
      property='og:description'
      content='Portfolio Web de Albert Lanza - Desarrollador Fullstack'
    />
    <meta property='og:image' content='###TODO_DO_INSERT_IMAGE_URL###' />
    <meta property='og:locale' content='es_ES' />
    <meta property='og:site_name' content='La Velada del Año V' />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:creator' content='@LnzAlbert' />
    <meta name='twitter:title' content='Portfolio Web de Albert Lanza' />
    <meta
      name='twitter:description'
      content='Portfolio Web de Albert Lanza - Desarrollador Fullstack'
    />
  </head>
  <body class='bg-primary-bckg-dark text-primary-text-dark'>
    <main class='max-w-3xl min-h-screen mx-auto border-x border-gray-300 p-8'>
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
