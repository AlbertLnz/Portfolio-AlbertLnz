---
import works from '@/assets/svgs/works.astro'
import projects from '@/assets/svgs/projects.astro'
import stack from '@/assets/svgs/stack.astro'
import blog from '@/assets/svgs/blog.astro'

const { title, subtitle, icon } = Astro.props as {
  title: string
  subtitle: string
  icon: IconKey
}

type IconKey = 'works' | 'projects' | 'stack' | 'blog'
const icons: Record<IconKey, (props: { class?: string }) => any> = {
  works,
  projects,
  stack,
  blog,
}

const Icon = icons[icon]
---

<div class='flex items-center justify-start gap-x-2'>
  <Icon class='size-6 text-secondary-text-dark' />
  <h2 class='text-geist text-2xl text-secondary-text-dark font-medium'>
    {title}
    <span class='text-sm font-extralight'>{subtitle}</span>
  </h2>
</div>
