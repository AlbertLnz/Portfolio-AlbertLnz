---
import works from '@/assets/svgs/works.astro'
import projects from '@/assets/svgs/projects.astro'
import stack from '@/assets/svgs/stack.astro'
import blog from '@/assets/svgs/blog.astro'
import CV from '@/assets/svgs/cv.astro'

const { id, title, subtitle, icon } = Astro.props as {
  id: string
  title: string
  subtitle: string
  icon: IconKey
}

type IconKey = 'works' | 'projects' | 'stack' | 'blog'
const icons: Record<IconKey, (props: { class?: string }) => any> = {
  works,
  projects,
  stack,
  blog,
}

const Icon = icons[icon]

const lastSectionId = 'stack' // Add 'scroll-mt-24' unless it's the last section
---

<section
  id={id}
  class=`flex flex-col md:flex-row items-start md:items-baseline justify-center md:justify-start gap-x-2 ${lastSectionId !== id ? 'scroll-mt-24' : 'mt-12'}`
>
  <div class='flex justify-start items-baseline gap-x-2'>
    <Icon
      class='size-6 text-secondary-text dark:text-secondary-text-dark self-center'
    />
    <h2
      class='flex flex-wrap md:flex-nowrap gap-2 items-baseline text-geist text-2xl text-secondary-text dark:text-secondary-text-dark font-medium'
    >
      {title}
    </h2>
  </div>
  <p class='text-sm font-extralight text-balance'>
    {subtitle}
    {
      id === 'works' ? (
        <span class='inline-flex pl-1 transition-colors duration-200 ease-in-out hover:text-primary-text dark:hover:text-primary-text-dark'>
          <a href='/CV - Albert Lanza (EN).pdf' download>
            <CV class='size-4' />
          </a>
        </span>
      ) : null
    }
  </p>
</section>

<style>
  :root {
    --header-offset-mobile: 8rem;
  }

  @media (max-width: 768px) {
    #works,
    #projects,
    #stack {
      scroll-margin-top: var(--header-offset-mobile);
    }
  }
</style>
