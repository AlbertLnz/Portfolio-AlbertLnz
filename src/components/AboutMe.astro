---
import SkillHighlight from '@/components/SkillHighlight.astro'
import Leadership from '@/assets/svgs/skills/Leadership.astro'
import ProblemSolving from '@/assets/svgs/skills/ProblemSolving.astro'
import TimeManagement from '@/assets/svgs/skills/TimeManagement.astro'
import Badge from '@/components/Badge.astro'
---

<div
  class='flex flex-col md:flex md:flex-row justify-center items-center py-12 gap-6'
>
  <div class='h-40 group'>
    <div
      class='relative size-40 transition-transform duration-700 transform-3d group-hover:[transform:rotateY(180deg)]'
    >
      <div class='flip-box-front absolute backface-hidden'>
        <img
          src='albert_lanza.webp'
          class='size-40 rounded-full border border-primary-text/20 dark:border-primary-text-dark/20'
          alt='Albert Lanza profile picture'
        />
      </div>
      <div
        class='flip-box-back absolute backface-hidden transform rotate-y-180'
      >
        <img
          loading='lazy'
          src='albert_lanza_ghibli.webp'
          class='size-40 rounded-full border border-primary-text/20 dark:border-primary-text-dark/20'
          alt='Albert Lanza profile picture'
        />
      </div>
    </div>
  </div>

  <div
    class='flex flex-col justify-between items-center md:items-start h-full md:h-36 gap-y-6 md:gap-y-0'
  >
    <Badge>
      <p class='text-sm'>Available for work</p>
    </Badge>
    <p class='max-w-[95%] text-center md:text-start text-balance'>
      I'm Albert Lanza, a fullstack web developer from Barcelona with +2 years
      of experience. Passionate about databases, UI/UX design and building
      open-source software.
    </p>
    <div class='flex justify-start items-center gap-x-2'>
      <SkillHighlight
        Icon={Leadership}
        skillText='Leadership'
        colorKey='leadership'
      />
      <SkillHighlight
        Icon={ProblemSolving}
        skillText='Problem Solving'
        colorKey='problemSolving'
      />
      <SkillHighlight
        Icon={TimeManagement}
        skillText='Time Management'
        colorKey='timeManagement'
      />
    </div>
  </div>
</div>

<style>
  .flip-box-front,
  .flip-box-back {
    -webkit-backface-visibility: hidden; /* Safari */
  }
</style>
