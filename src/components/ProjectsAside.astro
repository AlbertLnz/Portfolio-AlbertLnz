---
import type { Project } from '@/content/configTypes'
import { getLangFromUrl } from '@/i18n/utils'

const { projects }: { projects: Project[] } = Astro.props as {
  projects: Project[]
}
const lang = getLangFromUrl(Astro.url)

import ActivitiesManagement from '@/assets/projects/ActivitiesManagement.astro'
import FixItNow from '@/assets/projects/FixItNow.astro'
import MyTrackingRoutes from '@/assets/projects/MyTrackingRoutes.astro'
import PackagePhobiaCLI from '@/assets/projects/PackagePhobiaCLI.astro'
import Plt2Img from '@/assets/projects/Plt2Img.astro'
import SchoolManagement from '@/assets/projects/SchoolManagement.astro'
import SpringInitializrCLI from '@/assets/projects/SpringInitializrCLI.astro'
import WheresMidu from '@/assets/projects/WheresMidu.astro'

type SvgComponentType = (props: { class?: string }) => Astro

const svgComponents: Record<string, SvgComponentType | undefined> = {
  ActivitiesManagement,
  FixItNow,
  MyTrackingRoutes,
  PackagePhobiaCLI,
  Plt2Img,
  SchoolManagement,
  SpringInitializrCLI,
  WheresMidu,
}
---

<ul class='flex flex-col items-start justify-center text-xl gap-y-6'>
  {
    projects.map((project) => {
      const SvgComponent = svgComponents[project.data.svgComponentName]

      return (
        <li class='flex gap-x-4'>
          {SvgComponent && <SvgComponent class='size-8' />}
          <button
            id={`project-${project.data.id}`}
            class='text-secondary-light dark:text-secondary-dark hover:text-black/90 dark:hover:text-white/90'
          >
            {project.data.title}
          </button>
        </li>
      )
    })
  }
</ul>
