---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import ListItemBadge from '@/components/ListItemBadge.astro'

const { title, description, imgPath, imgAlt, deployUrl, techs, techsUrls } =
  Astro.props as {
    title: string
    description: string
    imgPath: string
    imgAlt: string
    deployUrl: string
    techs: string[]
    techsUrls: string[]
  }

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/imgs/*.{jpeg,jpg,png,webp}'
)
---

<article
  class='relative flex flex-col gap-y-2 bg-primary-bckg dark:bg-primary-bckg-dark border border-primary-text/5 dark:border-primary-text-dark/5 border-opacity-5 rounded-[20px] p-2.5 w-[calc(50%-0.5rem)] transition-all duration-200 ease-in-out hover:scale-[1.02]'
>
  <a href={deployUrl} target='_blank'>
    <Image src={images[imgPath]()} class='w-full rounded-[10px]' alt={imgAlt} />
  </a>
  <div class='flex-1 flex flex-col justify-between mx-2 gap-y-3.5'>
    <div>
      <h3 class='text-xl font-medium'>{title}</h3>
      <p class='text-secondary-text dark:text-secondary-text-dark font-light'>
        {description}
      </p>
    </div>

    <ul class='flex-1 flex items-start gap-x-1'>
      {
        techs.map((skill, index) => (
          <ListItemBadge skill={skill} skillUrl={techsUrls[index]} />
        ))
      }
    </ul>
  </div>
</article>
