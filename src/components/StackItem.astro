---
const { stack, StackLogo, stackColors } = Astro.props as {
  stack: string
  StackLogo: any
  stackColors: string[]
}
---

<div class='card group'>
  <pixel-canvas data-colors={stackColors} data-gap='7' data-speed='40'
  ></pixel-canvas>
  <StackLogo
    className='size-4 max-w-4 max-h-4 opacity-70 group-hover:opacity-100'
  />
  <button class='opacity-70 group-hover:opacity-100'>{stack}</button>
</div>

<style>
  :root {
    --border-color: #808080;
    --hover-border-color: #4e4e4e;
    --ease-out: cubic-bezier(0.5, 1, 0.89, 1);
    --ease-in-out: cubic-bezier(0.45, 0, 0.55, 1);
    --border-radius: 10px;
    --opacity-no-hover: 0.7;
  }

  :root body.dark {
    --border-color: #27272a;
    --hover-border-color: #f5faf770;
  }

  .card {
    max-height: 40px;
    position: relative;
    display: flex;
    gap: 10px;
    padding: 2px 10px;
    justify-items: start;
    align-items: center;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    isolation: isolate;
    transition: border-color 200ms var(--ease-out);

    pixel-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      pointer-events: none;
      opacity: var(--opacity-no-hover);
      border-radius: var(--border-radius);
    }

    svg {
      z-index: 1;
      transition: 300ms var(--ease-out);
      transition-property: color, scale;
    }

    button {
      pointer-events: none;
      font-weight: 700;
      font-size: large;
      letter-spacing: 0.05em;
    }

    &:focus-within {
      outline: 5px auto Highlight;
      outline: 5px auto -webkit-focus-ring-color;
    }

    &:where(:hover, :focus-within) {
      border-color: var(--active-color, var(--hover-border-color));
      transition: border-color 800ms var(--ease-in-out);
    }

    &:where(:hover, :focus-within) svg {
      color: var(--active-color, var(--hover-border-color));
      scale: 1.1;
      transition: 300ms var(--ease-in-out);
    }

    &:where(:hover, :focus-within)::before {
      opacity: 0;
    }

    &:where(:hover, :focus-within)::after {
      opacity: 1;
    }
  }
</style>

<script src='../scripts/pixel-canvas.js'></script>
