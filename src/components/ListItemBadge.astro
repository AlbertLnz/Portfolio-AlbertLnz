---
import Access from '@/assets/svgs/skills/Access.astro'
import Angular from '@/assets/svgs/skills/Angular.astro'
import AstroC from '@/assets/svgs/skills/AstroC.astro'
import Codeigniter from '@/assets/svgs/skills/Codeigniter.astro'
import Django from '@/assets/svgs/skills/Django.astro'
import Excel from '@/assets/svgs/skills/Excel.astro'
import Expressjs from '@/assets/svgs/skills/Expressjs.astro'
import FastAPI from '@/assets/svgs/skills/FastAPI.astro'
import Flask from '@/assets/svgs/skills/Flask.astro'
import Git from '@/assets/svgs/skills/Git.astro'
import GitLab from '@/assets/svgs/skills/GitLab.astro'
import Java from '@/assets/svgs/skills/Java.astro'
import JavaScript from '@/assets/svgs/skills/JavaScript.astro'
import Laravel from '@/assets/svgs/skills/Laravel.astro'
import Mapbox from '@/assets/svgs/skills/Mapbox.astro'
import MariaDB from '@/assets/svgs/skills/MariaDB.astro'
import MongoDB from '@/assets/svgs/skills/MongoDB.astro'
import MySQL from '@/assets/svgs/skills/MySQL.astro'
import NextJS from '@/assets/svgs/skills/NextJS.astro'
import Nodejs from '@/assets/svgs/skills/Nodejs.astro'
import PHP from '@/assets/svgs/skills/PHP.astro'
import PostgreSQL from '@/assets/svgs/skills/PostgreSQL.astro'
import PowerBI from '@/assets/svgs/skills/PowerBI.astro'
import Preact from '@/assets/svgs/skills/Preact.astro'
import Python from '@/assets/svgs/skills/Python.astro'
import React from '@/assets/svgs/skills/React.astro'
import Redux from '@/assets/svgs/skills/Redux.astro'
import Rust from '@/assets/svgs/skills/Rust.astro'
import SpringBoot from '@/assets/svgs/skills/SpringBoot.astro'
import SQLite from '@/assets/svgs/skills/SQLite.astro'
import Svelte from '@/assets/svgs/skills/Svelte.astro'
import TypeScript from '@/assets/svgs/skills/TypeScript.astro'
import Vitest from '@/assets/svgs/skills/Vitest.astro'
import Adaptability from '@/assets/svgs/skills/Adaptability.astro'
import ContinousLearning from '@/assets/svgs/skills/ContinousLearning.astro'
import EffectiveCommunication from '@/assets/svgs/skills/EffectiveCommunication.astro'
import Leadership from '@/assets/svgs/skills/Leadership.astro'
import Organization from '@/assets/svgs/skills/Organization.astro'
import ProblemSolving from '@/assets/svgs/skills/ProblemSolving.astro'
import TimeManagement from '@/assets/svgs/skills/TimeManagement.astro'

type Techs =
  | 'Access'
  | 'Angular'
  | 'AstroC'
  | 'Codeigniter'
  | 'Django'
  | 'Excel'
  | 'Expressjs'
  | 'FastAPI'
  | 'Flask'
  | 'Git'
  | 'GitLab'
  | 'Java'
  | 'JavaScript'
  | 'Laravel'
  | 'Mapbox'
  | 'MariaDB'
  | 'MongoDB'
  | 'MySQL'
  | 'NextJS'
  | 'Nodejs'
  | 'PHP'
  | 'PostgreSQL'
  | 'PowerBI'
  | 'Preact'
  | 'Python'
  | 'React'
  | 'Redux'
  | 'Rust'
  | 'SpringBoot'
  | 'SQLite'
  | 'Svelte'
  | 'TypeScript'
  | 'Vitest'

type Skills =
  | 'Adaptability'
  | 'ContinousLearning'
  | 'EffectiveCommunication'
  | 'Leadership'
  | 'Organization'
  | 'ProblemSolving'
  | 'TimeManagement'

const { skill, skillUrl } = Astro.props as {
  skill: Techs | Skills
  skillUrl: string
}

type IconKey = Techs | Skills
const icons: Record<IconKey, (props: { class?: string }) => any> = {
  Access,
  Angular,
  AstroC,
  Codeigniter,
  Django,
  Excel,
  Expressjs,
  FastAPI,
  Flask,
  Git,
  GitLab,
  Java,
  JavaScript,
  Laravel,
  Mapbox,
  MariaDB,
  MongoDB,
  MySQL,
  NextJS,
  Nodejs,
  PHP,
  PostgreSQL,
  PowerBI,
  Preact,
  Python,
  React,
  Redux,
  Rust,
  SpringBoot,
  SQLite,
  Svelte,
  TypeScript,
  Vitest,
  Adaptability,
  ContinousLearning,
  EffectiveCommunication,
  Leadership,
  Organization,
  ProblemSolving,
  TimeManagement,
}

const skillJoinStr = skill.replace(' ', '')
const Icon = icons[skillJoinStr as IconKey] || null

const skillDisplayName = skill === 'AstroC' ? 'Astro' : skill
---

<li
  class='bg-gradient-to-r from-[#DDDDDD] dark:from-[#0A0A0A] to-90% to-[#DDDDDD] dark:to-[#0A0A0A]/80 w-fit px-2 py-1 rounded-full text-xs font-extralight'
>
  {
    skillUrl.length > 0 ? (
      <a href={skillUrl} target='_blank' class='h-full flex gap-x-2'>
        {Icon && <Icon class='size-4' />}
        <p class='text-transparent bg-gradient-to-b from-primary-text dark:from-primary-text-dark from-30% to-primary-text/70 dark:to-primary-text-dark/70 bg-clip-text'>
          {skillDisplayName}
        </p>
      </a>
    ) : (
      <p class='h-full flex gap-x-2'>
        <Icon class='size-4' />
        <span class='text-transparent bg-gradient-to-b from-primary-text dark:from-primary-text-dark from-30% to-primary-text/70 dark:to-primary-text-dark/70 bg-clip-text'>
          {skillDisplayName}
        </span>
      </p>
    )
  }
</li>
