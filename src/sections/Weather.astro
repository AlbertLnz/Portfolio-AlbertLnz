---
import {
  PRODUCTION,
  OPEN_WEATHER_API_URL,
  OPEN_WEATHER_API_KEY,
} from 'astro:env/server'
import { assignIconWeatherArr } from '@/data/weatherIcon.js'
import { homePageWeatherTranslations } from '@/i18n/translations'

let timestamp,
  timezone,
  city = 'Barcelona',
  temp,
  humidity,
  wind,
  mainWeather,
  descriptWeather

if (PRODUCTION) {
  const headers = Astro.request.headers
  city = decodeURIComponent(headers.get('x-vercel-ip-city') || city)

  const weatherData = await fetchWeatherData(city)
  if (weatherData) {
    ;({
      timestamp,
      timezone,
      temp,
      humidity,
      wind,
      mainWeather,
      descriptWeather,
    } = weatherData)
  }
} else {
  timestamp = 1727244822
  timezone = 3600
  city = 'Cerdanyola del Vallès'
  temp = 36.6
  wind = 4.63
  humidity = 41
  mainWeather = 'Drizzle'
  descriptWeather = 'heavy intensity drizzle'
}

async function fetchWeatherData(city: string) {
  try {
    const res = await fetch(
      `${OPEN_WEATHER_API_URL}q=${city}&units=metric&appid=${OPEN_WEATHER_API_KEY}`
    )
    const data = await res.json()
    return {
      timestamp: data.dt,
      timezone: data.timezone,
      temp: data.main.temp,
      humidity: data.main.humidity,
      wind: data.wind.speed,
      mainWeather: data.weather[0].main,
      descriptWeather: data.weather[0].description,
    }
  } catch (error) {
    console.error('Error fetching weather data:', error)
    return null
  }
}

const timezoneHours = timezone / 3600
const date = new Date(timestamp * 1000)
const hours = date.getUTCHours() + timezoneHours
const isDay = hours < 21 ? 'day' : 'night'
const roundTemp = Math.round(temp)

let descriptWeatherFilter = ''
const iconsWithDoubleIcons = ['clear sky', 'few clouds', 'scattered clouds']
if (iconsWithDoubleIcons.includes(descriptWeather)) {
  descriptWeatherFilter =
    isDay === 'day' ? `${descriptWeather}_day` : `${descriptWeather}_night`
} else {
  descriptWeatherFilter = descriptWeather
}

let iconWeather = assignIconWeatherArr.find((weather) =>
  weather.name.includes(descriptWeatherFilter)
) as (typeof assignIconWeatherArr)[0]
if (!iconWeather)
  iconWeather = assignIconWeatherArr.find(
    (weather) => weather.name === 'unknown'
  ) as (typeof assignIconWeatherArr)[0]

const { windTitle, humidityTitle } = homePageWeatherTranslations(Astro.url)
---

<section
  id='weather'
  transition:name='weather'
  class={`
  border-none
  bg-gradient-to-b from-[#074A8E] to-[#5596D8] dark:from-[#020518] dark:to-[#283555] 
  p-0 flex items-center justify-center 
`}
>
  <div
    class={`
    text-white dark:text-primary-dark
    grid grid-cols-[70%_30%] rounded-[22px] w-full h-full py-2 px-4 gap-y-2 md:gap-y-0
  `}
  >
    <h6 class='flex self-center text-[14px] font-semibold mt-2 md:mt-0'>
      {city}
    </h6>
    {
      (
        <iconWeather.component
          class='size-6 flex justify-self-end'
          color='#fff'
        />
      )
    }

    <h5 class='ml-1 text-[24px] font-bold'>{roundTemp}º</h5>
    <p class='flex justify-self-end self-start font-medium'>{mainWeather}</p>

    <p class='ml-1 text-[10px] flex self-center'>· {windTitle}:</p>
    <p class='text-[10px] flex justify-self-end self-center'>{wind} m/s</p>

    <p class='ml-1 text-[10px] flex self-center'>· {humidityTitle}:</p>
    <p class='text-[10px] flex justify-self-end self-center'>{humidity} %</p>

    <p class='ml-1 text-[10px] flex self-center'>
      ·
      <span id='hours' data-timezone={timezone}></span>
      :
      <span id='minutes'></span>
      h / 24h:
    </p>
    <p class='text-[10px] flex justify-self-end self-center'></p>

    <div
      class='h-[2px] flex items-center justify-center place-content-center rounded-full bg-[#336BA3] dark:bg-[#0E1730] col-span-2 relative'
    >
      <div
        id='progressBar'
        class='absolute top-0 left-0 h-full bg-[#85A7C9] dark:bg-[#606374] rounded-full'
      >
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    // Client-side rendering for updating hours, minutes & progressBar
    const SECOND = 1000
    const totalSecondsInDay = 24 * 60 * 60

    const $ = (el: string): HTMLElement | null => document.querySelector(el)
    const $hours = $(`#hours`)
    const $minutes = $(`#minutes`)
    const $progressBar = $(`#progressBar`)

    const timezoneHours = $hours ? Number($hours.dataset.timezone) / 3600 : 2 // default: UTC-2

    const updateTime = () => {
      const date = new Date()
      const hours = (date.getUTCHours() + timezoneHours) % 24
      const minutes = date.getUTCMinutes().toString().padStart(2, '0')
      const secondsElapsedUntilNow = (date.valueOf() / 1000) % totalSecondsInDay
      const progress = (secondsElapsedUntilNow / totalSecondsInDay) * 100

      $hours
        ? ($hours.innerHTML = `&nbsp;${hours.toString().padStart(2, '0')}`)
        : '00'
      $minutes ? ($minutes.innerHTML = minutes) : '00'
      $progressBar ? ($progressBar.style.width = `${progress}%`) : ''
    }

    const scheduleUpdate = () => {
      const now = new Date()
      const millisecondsUntilNextMinute = (60 - now.getUTCSeconds()) * SECOND

      setTimeout(() => {
        updateTime()
        scheduleUpdate()
      }, millisecondsUntilNextMinute)
    }

    updateTime()
    scheduleUpdate()
  })
</script>
