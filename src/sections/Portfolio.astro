---
import Figma from '@/assets/icons/Figma.astro'
import GitHub from '@/assets/icons/GitHub.astro'
import { homePagePortfolioTranslations } from '@/i18n/translations'

const { text_one, text_two, text_three, text_four } =
  homePagePortfolioTranslations(Astro.url)
---

<section
  id='portfolio'
  class={`
    bg-section-bg-light/80 hover:bg-gray-200/70 dark:bg-black/80 dark:hover:bg-black/50
    border-2 border-section-primary-border-light dark:border-section-primary-border-dark
    text-primary-light dark:text-primary-dark
    flex flex-col items-center justify-center w-full h-full
  `}
  transition:name='portfolio'
>
  <h3 class='font-medium'>
    {text_one}
    <span class='font-bold'>{text_two}</span>.
  </h3>
  <h3 class='font-medium'>
    {text_three}
    <span class='font-bold'>{text_four}</span>.
  </h3>

  <div class='flex items-center justify-center gap-x-6 pt-4'>
    <a
      href='https://www.figma.com/design/Sl88cvea9AMyaJleouM0Rp/Portfolio-AlbertLnz?node-id=0-1&t=7pqXdwZE3izB5rtP-1'
      target='_blank'
    >
      <Figma
        class='size-7 hover:scale-[1.2] transition-all ease-in duration-200'
      />
    </a>
    <a href='https://github.com/AlbertLnz/Portfolio-AlbertLnz' target='_blank'>
      <GitHub
        class='size-7 hover:scale-[1.2] transition-all ease-in duration-200 fill-black/80 hover:fill-black dark:fill-[#D1D5DB] dark:hover:fill-white'
      />
    </a>
  </div>
</section>
