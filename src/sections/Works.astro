---
import WorkItem from '@/components/WorkItem.astro'
import type { IWork } from '@/types/Work'

const myWorks: IWork[] = [
  {
    title: 'Backend Developer',
    paragraph:
      'as a key team member on a management system project, contributing the migration from CodeIgniter 3 to Laravel 10 with PHP 8.2 and MySQL. Implemented and maintained automated testing using PHPUnit, ensuring code reliability and performance. Managed version control workflows with Git and GitLab, contributing to a clean, efficient, and collaborative development process.',
    skills: [
      'PHP',
      'Laravel',
      'Codeigniter',
      'MySQL',
      'Git',
      'GitLab',
      'Organization',
      'Continous Learning',
    ],
    skills_urls: [
      'https://php.net',
      'https://laravel.com',
      'https://codeigniter.com',
      'https://www.mysql.com',
      'https://git-scm.com',
      'https://about.gitlab.com',
      '',
      '',
    ],
    company: 'No Country',
    company_url: 'https://www.nocountry.com',
    period: '10/2023 - 06/2024',
  },
  {
    title: 'Frontend Developer',
    paragraph:
      'for a job-matching communication platform connecting job seekers and recruiters. Responsible for building and maintaining user-facing features using Next.js 13, TypeScript, Redux, and Vitest for testing. Actively collaborated with the backend team (PHP) to ensure seamless API integration and efficient data flow, participating in continuous integration workflows to maintain code quality and deployment stability.',
    skills: [
      'React',
      'NextJS',
      'Laravel',
      'TypeScript',
      'Redux',
      'Vitest',
      'Adaptability',
      'Effective Communication',
    ],
    skills_urls: [
      'https://react.dev',
      'https://nextjs.org',
      'https://laravel.com',
      'https://www.typescriptlang.org',
      'https://redux.js.org',
      'https://vitest.dev',
      '',
      '',
    ],
    company: 'IT Academy',
    company_url: 'https://www.nocountry.com',
    period: '06/2023 - 10/2023',
  },
]
---

<section class='mt-4 mb-12'>
  {myWorks.map((work) => <WorkItem {...work} />)}
</section>
