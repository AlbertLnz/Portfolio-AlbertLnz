---
import ToggleTheme from '@/assets/svgs/toggleTheme.astro'
import LinkedIn from '@/assets/svgs/LinkedIn.astro'
---

<header
  class='flex sticky top-0 font-geist items-center justify-between max-w-full pt-4 z-10'
>
  <div
    class='flex items-center justify-between gap-x-6 px-6 py-4 border border-primary-text/5 dark:border-primary-text-dark/5 border-opacity-5 rounded-[20px]'
  >
    <h1 id='name' class='font-medium cursor-pointer'>Albert Lanza</h1>
    <span class='text-secondary-text dark:text-secondary-text-dark'>/</span>
    <a href='#works' class='header-section-link'>
      <h3
        class='text-secondary-text dark:text-secondary-text-dark cursor-pointer
        hover:text-primary-text dark:hover:text-primary-text-dark transition-colors duration-300'
      >
        Works
      </h3>
    </a>
    <a href='#projects' class='header-section-link'>
      <h3
        class='text-secondary-text dark:text-secondary-text-dark cursor-pointer
        hover:text-primary-text dark:hover:text-primary-text-dark transition-colors duration-300'
      >
        Projects
      </h3>
    </a>
    <a href='#stack' class='header-section-link'>
      <h3
        class='text-secondary-text dark:text-secondary-text-dark cursor-pointer
        hover:text-primary-text dark:hover:text-primary-text-dark transition-colors duration-300'
      >
        Stack
      </h3>
    </a>
  </div>

  <div
    class='flex items-center justify-center gap-x-4 p-2 pr-4 border border-primary-text/5 dark:border-primary-text-dark/5 rounded-[20px]'
  >
    <a
      href='mailto:albert.lnz.rio@gmail.com'
      class='cursor-pointer bg-[#ddd] dark:bg-[#161717] px-4 py-2 border-primary-text/5 dark:border-primary-text-dark/5 rounded-[10px] dark:hover:text-white'
    >
      <h2
        class='text-primary-text/90 dark:text-primary-text-dark/90 transition-colors duration-100 ease-in-out hover:text-primary-text hover:dark:text-primary-text-dark'
      >
        Let's chat
      </h2>
    </a>
    <div class='flex items-center justify-center gap-x-2'>
      <a href='https://www.linkedin.com/in/albert-lanza-rio/' target='_blank'>
        <LinkedIn class='size-5' />
      </a>
      <ToggleTheme
        class='toggle-theme fill-primary-text dark:fill-white size-5 cursor-pointer transition-transform duration-300 ease-in-out transform origin-center'
      />
    </div>
  </div>
</header>

<style>
  /* HEADER BACKGROUND BLUR ANIMATION ON SCROLL */
  :root {
    --header-bg: #f4f1f8;
  }

  body.dark {
    --header-bg: #0e0f0f;
  }
  header {
    background: transparent;
    animation: header-blur-scroll 0.3s linear both;
    animation-timeline: scroll();
    animation-range: 0 500px;
  }

  @keyframes header-blur-scroll {
    0% {
      backdrop-filter: blur(0px);
      background: transparent;
    }
    100% {
      backdrop-filter: blur(10px);
      background: var(--header-bg);
      padding-bottom: 1rem;
    }
  }

  /* HOVER UNDERLINE ANIMATION */
  .header-section-link {
    color: inherit;
    text-decoration: none;
    background: linear-gradient(to right, currentColor, currentColor);
    background-size: 0 0.05em;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 400ms;
  }

  .header-section-link:hover {
    background-size: 100% 0.05em;
  }
</style>

<script>
  const toggleThemeBtn = document.querySelector('.toggle-theme')
  toggleThemeBtn?.addEventListener('click', () => {
    toggleThemeBtn.classList.toggle('rotate-180')

    if (document.body.classList.contains('dark')) {
      document.body.classList.remove('dark')
      localStorage.setItem('theme', 'light')
    } else {
      document.body.classList.add('dark')
      localStorage.setItem('theme', 'dark')
    }
  })

  const nameHeading = document.querySelector('#name')
  nameHeading?.addEventListener('click', () => {
    document.documentElement.scrollIntoView({
      behavior: 'smooth',
      block: 'start',
    })
    if (window.location.hash) {
      history.replaceState(null, '', window.location.pathname)
    }
  })
</script>
