---
import GitHub from '@/assets/svgs/GitHub.astro'
import LinkedIn from '@/assets/svgs/LinkedIn.astro'
---

<header
  class='flex sticky top-0 font-geist items-center justify-between max-w-full'
>
  <div
    class='flex items-center justify-between gap-x-6 px-6 py-4 border border-[#F5FAF7]/5 border-opacity-5 rounded-[20px]'
  >
    <a href='#'>
      <h1 class='font-medium cursor-pointer'>Albert Lanza</h1>
    </a>
    <span class='text-secondary-text-dark'>/</span>
    <a href='#'>
      <h3 class='text-secondary-text-dark cursor-pointer'>Works</h3>
    </a>
    <a href='#'>
      <h3 class='text-secondary-text-dark cursor-pointer'>Projects</h3>
    </a>
    <a href='#'>
      <h3 class='text-secondary-text-dark cursor-pointer'>Stack</h3>
    </a>
    <a href='#'>
      <h3 class='text-secondary-text-dark cursor-pointer'>Blog</h3>
    </a>
  </div>

  <div
    class='flex items-center justify-center gap-x-4 p-2 pr-4 border border-[#F5FAF7]/5 rounded-[20px]'
  >
    <a
      href='mailto:albert.lnz.rio@gmail.com'
      class='cursor-pointer bg-[#161717] px-4 py-2 border-[#F5FAF7]/5 rounded-[10px] hover:text-white'
    >
      <h2>Let's chat</h2>
    </a>
    <div class='flex items-center justify-center gap-x-2'>
      <a href='https://www.linkedin.com/in/albert-lanza-rio/' target='_blank'>
        <LinkedIn class='size-5' />
      </a>
      <a href='https://github.com/albertlnz' target='_blank'>
        <GitHub class='size-5' />
      </a>
    </div>
  </div>
</header>
