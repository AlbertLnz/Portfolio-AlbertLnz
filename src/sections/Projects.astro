---
import ProjectItem from '@/components/ProjectItem.astro'

const myProjects = [
  [
    'Northwind SQL Practice',
    'Practice SQL queries with Northwind database.',
    '/src/assets/imgs/Northwind_SQL.webp',
    'https://northwind-sql-alr.vercel.app/',
    ['MySQL', 'SQLite', 'React'],
    [
      'https://www.mysql.com',
      'https://www.sqlite.org',
      'https://reactjs.org',
      'https://tailwindcss.com',
    ],
  ],
  [
    'PkgPhobia CLI',
    'Check NPM package through the command line.',
    '/src/assets/imgs/PkgPhobia_CLI.webp',
    'https://www.npmjs.com/package/pkg-phobia-cli',
    ['JavaScript', 'Nodejs'],
    ['https://www.javascript.com', 'https://nodejs.org'],
  ],
  [
    'Plt2Img',
    'Graphs from Python code to image, instantly.',
    '/src/assets/imgs/Plt2Img.webp',
    'https://plt2img.online/',
    ['AstroC', 'Python', 'Flask'],
    [
      'https://astro.build',
      'https://www.python.org',
      'https://flask.palletsprojects.com',
    ],
  ],
  [
    'Spring Initializr CLI',
    'Spring Initializr CLI, extremely fast start-up for Spring Boot projects.',
    '/src/assets/imgs/Spring_Initializr_CLI.webp',
    'https://crates.io/crates/spring-initializr-cli',
    ['Rust', 'SpringBoot'],
    ['https://www.rust-lang.org', 'https://spring.io'],
  ],
  [
    "Where's Midu?",
    "Hackathon Halloween 'Where's Waldo' game.",
    '/src/assets/imgs/Wheres_midu.webp',
    'https://www.wheres-midu.site/es',
    ['AstroC', 'Preact'],
    ['https://astro.build', 'https://preactjs.com'],
  ],
  [
    'My Tracking Routes',
    'My mountain tracking routes in 3D ⛰️',
    '/src/assets/imgs/My_Tracking_Routes.webp',
    'https://albertlnz-routes.netlify.app/',
    ['React', 'Mapbox'],
    ['https://reactjs.org', 'https://www.mapbox.com'],
  ],
]
---

<section class='mb-1'>
  <ul class='flex flex-wrap justify-between pt-4 gap-y-4'>
    {
      myProjects.map((project) => (
        <ProjectItem
          title={project[0]}
          description={project[1]}
          imgPath={project[2]}
          imgAlt={`${project[0]}_project_image`}
          deployUrl={project[3]}
          techs={project[4]}
          techsUrls={project[5]}
        />
      ))
    }
  </ul>
</section>
