---
import GitHub from '@/assets/svgs/GitHub.astro'
import Figma from '@/assets/svgs/Figma.astro'

const year = new Date().getFullYear()
---

<footer
  class='bg-gradient-to-t from-footer-bckg to-[20%] to-primary-bckg dark:from-footer-bckg-dark dark:to-primary-bckg-dark grid grid-cols-1 md:grid-cols-3 gap-x-4 md:gap-y-2 pt-8 pb-12 px-4 text-center -mx-8'
>
  <h4 class='font-light order-1 md:order-none'>Made by Albert Lanza</h4>
  <h5 class='font-light order-3 md:order-none'>Thanks for visiting!</h5>
  <div class='flex justify-center items-center gap-2 order-5 md:order-none'>
    <h5 class='font-light'>Visit the code</h5>
    <button id='btn-scroll-top' class='cursor-pointer'>⇑</button>
  </div>
  <p
    class='text-secondary-text dark:text-secondary-text-dark text-xs font-extralight order-2 md:order-none mb-6 md:mb-0'
  >
    © {year} | All rights reserved
  </p>
  <p
    class='text-secondary-text dark:text-secondary-text-dark text-xs font-extralight order-4 md:order-none mb-6 md:mb-0'
  >
    Stay awesome
  </p>
  <div class='flex justify-center items-center gap-4 order-6 md:order-none'>
    <a href='https://github.com/AlbertLnz/Portfolio-AlbertLnz' target='_blank'>
      <GitHub className='size-5 fill-[#111] dark:fill-white' />
    </a>
    <a
      href='https://www.figma.com/design/Sl88cvea9AMyaJleouM0Rp/Portfolio-AlbertLnz?node-id=319-21&t=OAoarPvIJN9VfroX-1'
      target='_blank'
    >
      <Figma className='size-5' />
    </a>
  </div>
</footer>

<script>
  const scrollTopBtn = document.getElementById('btn-scroll-top')
  scrollTopBtn?.addEventListener('click', () => {
    document.documentElement.scrollIntoView({
      behavior: 'smooth',
      block: 'start',
    })
  })
</script>
